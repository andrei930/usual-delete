{
  "manifest_version": 3,
  "name": "Usual Delete — Gmail selector",
  "version": "1.0.2",
  "description": "Learn which senders you delete unread, then select their unread inbox conversations in one click. Never deletes mail for you.",
  "minimum_chrome_version": "109",
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Usual Delete", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["core.js", "gmail.js", "content.js"], "run_at": "document_idle"}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
